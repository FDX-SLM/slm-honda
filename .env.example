# Copy to `.env` and fill in. `.env` is gitignored and never committed.
# Loaded automatically via python-dotenv; secrets are read from the environment only.

# --- LLM-as-judge API keys (evaluation only; GPT + Gemini, never Claude/DeepSeek) ---
OPENAI_API_KEY=sk-...
GOOGLE_API_KEY=...

# --- Experiment tracking (Langfuse: qualitative sample-generation logging) ---
LANGFUSE_PUBLIC_KEY=pk-lf-68beeef0-e420-460b-b5e1-1db4408c990b
LANGFUSE_SECRET_KEY=sk-lf-f70ecd03-ca84-4552-b5c9-3bb6c752bd67
# Region host: EU = https://cloud.langfuse.com, US = https://us.cloud.langfuse.com
LANGFUSE_HOST=https://jp.cloud.langfuse.com/

# --- Hugging Face (optional: gated base models / private hub) ---
HF_TOKEN=hf_...

# --- Web demo (webdemo/): base model + adapter cho SLM closed-book ---
HONDA_BASE=Qwen/Qwen3.5-9B
HONDA_ADAPTER=/workspace/honda-adapters/dpo_qwen
HONDA_4BIT=false
HONDA_MAX_NEW_TOKENS=1700
# Chống lặp customer_self_service ở ca eligibility (đẻ tier vô hạn → JSON không đóng → parse lỗi).
# 1.05 phá vòng lặp mà không đổi root cause; 1.1 quá mạnh (làm sai RC ca khác). Để rỗng/1.0 để tắt.
HONDA_REPETITION_PENALTY=1.05

# --- Tăng tốc bằng vLLM (tùy chọn, ~3x). Chạy server vLLM ở venv cô lập rồi backend gọi qua HTTP.
#     Bỏ trống VLLM_URL để backend tự nạp HF transformers thay thế. Xem webdemo/run_vllm.sh ---
VLLM_URL=http://127.0.0.1:8800/v1
VLLM_MODEL=dpo_qwen
# INT4 (bitsandbytes nf4, in-flight): decode ~2.2x nhanh hơn bf16 (~125 vs ~57 tok/s).
# setup.sh cài sẵn bitsandbytes vào vLLM venv. Đặt rỗng (VLLM_QUANT=) để quay lại bf16.
VLLM_QUANT=bitsandbytes

# --- Web demo: Gemini (LLM tổng quát làm baseline đối chứng với SLM; KHÔNG phải judge chấm điểm).
#     Dùng GOOGLE_API_KEY ở trên. Bỏ key → demo dùng mock có nhãn. Key CHỈ đọc ở server, không xuống
#     client. Model nhỏ (free tier hết quota nhanh); gemini-2.5-flash-lite hiện dùng được. ---
GEMINI_MODEL=gemini-2.5-flash-lite
DEEPSEEK_BASE_URL=https://api.deepseek.com
